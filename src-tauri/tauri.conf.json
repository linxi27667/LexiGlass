{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LexiGlass",
  "version": "0.1.0",
  "identifier": "com.linxi27667.lexiglass",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "琉璃记 · LexiGlass — 现代毛玻璃全能记忆工作台",
        "url": "index.html",
        "width": 1220,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true
      },
      {
        "label": "bubble",
        "title": "随手记 · LexiGlass Bubble",
        "url": "bubble.html",
        "width": 360,
        "height": 440,
        "x": 1520,
        "y": 580,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
